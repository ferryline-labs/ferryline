{
  "name": "@ferryline/widget",
  "version": "0.0.0",
  "description": "Drop-in web component for depositing to and withdrawing from Stellar over Ferryline.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.6.0",
    "@ferryline/core": "workspace:*",
    "@ferryline/sdk": "workspace:*",
    "@stellar/stellar-sdk": "^17.0.1",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@stellar/freighter-api": "^6.0.0",
    "happy-dom": "^20.14.3",
    "playwright": "^1.63.0",
    "vite": "^8.3.0"
  }
}
