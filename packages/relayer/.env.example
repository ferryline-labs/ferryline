# Copy this file to .env and fill in real values. NEVER commit .env — it holds real secrets.
# See README.md's "Environment variables" section for the full explanation of each one.

# --- Genuinely required: the relayer refuses to start without these ---
FERRYLINE_NETWORK=testnet
POSTGRES_PASSWORD=change-me
FERRYLINE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
FERRYLINE_SPONSOR_SECRET=

# --- Spend-related, required, NO default (the relayer refuses to start without these too) ---
FERRYLINE_MAX_FEE_BUMP_STROOPS=10000000
FERRYLINE_DAILY_SPEND_CEILING_STROOPS=1000000000
FERRYLINE_MAX_TRANSFERS_PER_RECIPIENT=5
FERRYLINE_RECIPIENT_RATE_LIMIT_WINDOW_MS=3600000

# --- Allowed sensible defaults (performance/load knobs, not money-safety controls) ---
# Uncomment and change only if you need something other than the documented default.
# PORT=8080
# FERRYLINE_POLL_INTERVAL_MS=2000
# FERRYLINE_POLL_MAX_INTERVAL_MS=30000
# FERRYLINE_MAX_CONCURRENT_TRANSFERS=20
# FERRYLINE_REGISTRATION_LIMIT_MAX_ATTEMPTS=60
# FERRYLINE_REGISTRATION_LIMIT_WINDOW_MS=60000
# FERRYLINE_RELAYER_VERSION=0.0.0
# POSTGRES_HOST_PORT=5432

# --- CORS: optional even in production, but FAILS CLOSED (no browser origin allowed) when unset —
# never defaults to allow-all. Only needed if a browser-based caller (e.g. <ferryline-widget>
# hosted on a different origin than this relayer) will call this relayer directly; server-to-server
# callers are unaffected either way. See README.md's env var table / src/config.ts's
# RelayerConfig.corsOrigins doc comment for the full story. NEVER set this to "*".
# FERRYLINE_CORS_ORIGINS=https://your-widget-host.example.com,http://localhost:4173

# --- Outbound (Stellar -> EVM): OPT-IN, defaults to disabled. Leave FERRYLINE_OUTBOUND_ENABLED
# unset/false to run inbound-only (nothing below this line is read or required in that case). Set
# it to "true" and fill in every var below to also run the outbound direction in this same process
# — see README.md's "Outbound (Stellar -> EVM)" section for the full explanation. ---
FERRYLINE_OUTBOUND_ENABLED=false
# FERRYLINE_OUTBOUND_DESTINATION_CHAIN=ethereum-sepolia
# FERRYLINE_OUTBOUND_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# FERRYLINE_OUTBOUND_SPONSOR_SECRET=
# --- Outbound spend-related, required (no default) once FERRYLINE_OUTBOUND_ENABLED=true ---
# FERRYLINE_OUTBOUND_MAX_GAS_WEI=5000000000000000
# FERRYLINE_OUTBOUND_DAILY_GAS_CEILING_WEI=50000000000000000
# FERRYLINE_OUTBOUND_MAX_TRANSFERS_PER_RECIPIENT=5
# FERRYLINE_OUTBOUND_RECIPIENT_RATE_LIMIT_WINDOW_MS=3600000
# --- Outbound performance/load knobs, allowed sensible defaults ---
# FERRYLINE_OUTBOUND_POLL_INTERVAL_MS=2000
# FERRYLINE_OUTBOUND_POLL_MAX_INTERVAL_MS=30000
# FERRYLINE_OUTBOUND_MAX_CONCURRENT_TRANSFERS=20
