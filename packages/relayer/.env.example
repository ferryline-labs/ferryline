# Copy this file to .env and fill in real values. NEVER commit .env — it holds real secrets.
# See README.md's "Environment variables" section for the full explanation of each one.

# --- Genuinely required: the relayer refuses to start without these ---
FERRYLINE_NETWORK=testnet
POSTGRES_PASSWORD=change-me
FERRYLINE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
FERRYLINE_SPONSOR_SECRET=

# --- Spend-related, required, NO default (the relayer refuses to start without these too) ---
FERRYLINE_MAX_FEE_BUMP_STROOPS=10000000
FERRYLINE_DAILY_SPEND_CEILING_STROOPS=1000000000
FERRYLINE_MAX_TRANSFERS_PER_RECIPIENT=5
FERRYLINE_RECIPIENT_RATE_LIMIT_WINDOW_MS=3600000

# --- Allowed sensible defaults (performance/load knobs, not money-safety controls) ---
# Uncomment and change only if you need something other than the documented default.
# PORT=8080
# FERRYLINE_POLL_INTERVAL_MS=2000
# FERRYLINE_POLL_MAX_INTERVAL_MS=30000
# FERRYLINE_MAX_CONCURRENT_TRANSFERS=20
# FERRYLINE_REGISTRATION_LIMIT_MAX_ATTEMPTS=60
# FERRYLINE_REGISTRATION_LIMIT_WINDOW_MS=60000
# FERRYLINE_RELAYER_VERSION=0.0.0
# POSTGRES_HOST_PORT=5432
