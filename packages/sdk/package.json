{
  "name": "@ferryline/sdk",
  "version": "0.0.0",
  "description": "One interface for moving USDT0 and USDC in and out of Stellar: quote, build, sign, track.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "record:usdt0-fixtures": "tsx scripts/record-usdt0-mainnet-fixtures.ts",
    "record:cctp-fixtures": "tsx scripts/record-cctp-mainnet-fixtures.ts"
  },
  "dependencies": {
    "@ferryline/core": "workspace:*",
    "@stellar/stellar-sdk": "^17.0.1",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  }
}
